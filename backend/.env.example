PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/SkillForgeAI
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Google OAuth (fill in when connecting real OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/linkedin/callback

# LinkedIn / Job Data Provider (e.g. via an authorized aggregator like RapidAPI JSearch, Adzuna, etc.)
# NOTE: the built-in "Apply on LinkedIn" / "Search on LinkedIn" buttons work with NO keys at all —
# they generate real LinkedIn search/apply deep-links (see backend/services/linkedinService.js).
# These vars are only for wiring an official LinkedIn Talent API partnership (or another job data
# aggregator) into services/jobProviderService.js if/when you have one.
JOB_PROVIDER=mock
JOB_PROVIDER_API_KEY=
JOB_PROVIDER_API_HOST=

# Python ML Microservice (optional — pretrained models, see ml-service/README.md)
ML_SERVICE_URL=http://localhost:8000

# Gemini API — create a key in Google AI Studio and keep it only in backend/.env.
# The free tier has rate limits; SkillForge falls back to local ML if quota is
# exhausted or this value is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional — set ONE of these (as an environment variable for the ml-service process,
# see ml-service/README.md) to upgrade question/lesson/chat generation to a cloud LLM
# instead of the local flan-t5-base model. Not read by this Node backend directly.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
